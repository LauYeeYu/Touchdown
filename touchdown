#!/bin/sh
# Touchdown's command-line tools. Run "./touchdown help" for the list of commands.
dir=$(cd "$(dirname "$0")" && pwd)
if [ ! -x "$dir/node_modules/.bin/tsx" ]; then
  echo "Run npm install in $dir first." >&2
  exit 1
fi
exec "$dir/node_modules/.bin/tsx" "$dir/packages/cli/src/main.ts" "$@"
